NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email (Resend) — required for email sends from contact profiles
# Get API key from resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hello@wildrock.org

# Cal.com webhook secret — copy from Cal.com Dashboard → Webhooks → secret
# Required: the webhook handler will reject all requests without this
CAL_WEBHOOK_SECRET=your-cal-webhook-secret

# Upstash Redis — required for rate limiting on the Cal.com webhook endpoint
# Get these from Upstash Console → your Redis database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
